source 'https://rubygems.org'

gem 'jekyll'

# Plugins used by this site at build time.
group :jekyll_plugins do
    gem 'jekyll-cache-bust'
    gem 'jekyll-feed'
    gem 'jekyll-link-attributes'
    gem 'jekyll-regex-replace'
    gem 'jekyll-scholar'
    gem 'jekyll-sitemap'
    gem 'jekyll-socials'
end

# Keep the full pinned al-folio starter dependency set available. Runtime
# behavior is controlled by the feature flags in _config.yml.
group :available_plugins do
    gem 'jekyll-3rd-party-libraries', require: false
    gem 'jekyll-archives-v2', require: false
    gem 'jekyll-email-protect', require: false
    gem 'jekyll-get-json', require: false
    gem 'jekyll-imagemagick', require: false
    gem 'jekyll-jupyter-notebook', require: false
    gem 'jekyll-minifier', require: false
    gem 'jekyll-paginate-v2', require: false
    gem 'jekyll-tabs', require: false
    gem 'jekyll-terser', :git => "https://github.com/RobertoJBeltran/jekyll-terser.git", require: false
    gem 'jekyll-toc', require: false
    gem 'jekyll-twitter-plugin', require: false
    gem 'jemoji', require: false
    gem 'classifier-reborn', require: false
end

group :other_plugins do
    gem 'css_parser'
    gem 'observer'
    gem 'ostruct'
end

# Gems for al-folio plugins
group :al_folio_plugins do
